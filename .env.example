# ── Environment ──────────────────────────────────────────────────────────────
# local | dev | staging | production
# In non-local environments the backend REFUSES to start with default secrets.
ENVIRONMENT=local

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pm_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_TOPICS=factory/#,edge/#,sensors/+/telemetry

# ── Services ─────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Auth / Security ──────────────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60

# ── Notifications (optional; leave blank to disable email) ───────────────────
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
NOTIFICATION_EMAIL=
SLACK_WEBHOOK_URL=
